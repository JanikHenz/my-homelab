# Secrets for LibreChat
# IMPORTANT: These are PLACEHOLDERS. Generate real values before first deploy.
#
#   JWT_SECRET=$(openssl rand -hex 32)
#   JWT_REFRESH=$(openssl rand -hex 32)
#   CREDS_KEY=$(openssl rand -hex 32)
#   CREDS_IV=$(openssl rand -hex 16)
#   MEILI_KEY=$(openssl rand -hex 32)
#   kubectl create secret generic librechat-secrets -n jarvis \
#     --from-literal=jwt-secret="$JWT_SECRET" \
#     --from-literal=jwt-refresh-secret="$JWT_REFRESH" \
#     --from-literal=creds-key="$CREDS_KEY" \
#     --from-literal=creds-iv="$CREDS_IV" \
#     --from-literal=meili-master-key="$MEILI_KEY" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
apiVersion: v1
kind: Secret
metadata:
  name: librechat-secrets
  namespace: jarvis
type: Opaque
stringData:
  jwt-secret: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  jwt-refresh-secret: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  creds-key: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  creds-iv: "REPLACE_WITH_OPENSSL_RAND_HEX_16"
  meili-master-key: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
