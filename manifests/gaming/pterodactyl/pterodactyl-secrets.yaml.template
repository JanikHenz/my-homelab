# Secrets for Pterodactyl Panel and Wings
# IMPORTANT: These are PLACEHOLDERS. Run the commands below to generate real secrets
# and apply them to the cluster BEFORE deploying Pterodactyl.
#
# Generate and apply secrets:
#   APP_KEY=$(openssl rand -base64 32)
#   ROOT_PASS=$(openssl rand -base64 24)
#   DB_PASS=$(openssl rand -base64 24)
#   ADMIN_PASS=$(openssl rand -base64 16)
#   kubectl create secret generic pterodactyl-secrets -n gaming \
#     --from-literal=mariadb-root-password="$ROOT_PASS" \
#     --from-literal=mariadb-password="$DB_PASS" \
#     --from-literal=app-key="base64:$APP_KEY" \
#     --from-literal=admin-password="$ADMIN_PASS" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
apiVersion: v1
kind: Secret
metadata:
  name: pterodactyl-secrets
  namespace: gaming
type: Opaque
stringData:
  # MariaDB passwords - CHANGE THESE!
  mariadb-root-password: "REPLACE_WITH_GENERATED_PASSWORD"
  mariadb-password: "REPLACE_WITH_GENERATED_PASSWORD"
  # Pterodactyl Panel APP_KEY - MUST be base64: prefix + 32 byte key!
  app-key: "base64:REPLACE_WITH_OPENSSL_RAND_BASE64_32"
  # Admin user credentials for initial setup
  admin-password: "REPLACE_WITH_ADMIN_PASSWORD"
