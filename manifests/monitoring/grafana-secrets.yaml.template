# Secret for the Grafana admin user
# IMPORTANT: This is a PLACEHOLDER (".template" files are NOT synced by ArgoCD).
# Create the real secret in the cluster BEFORE syncing the monitoring app:
#
#   kubectl create secret generic grafana-secrets -n monitoring \
#     --from-literal=admin-password="$(openssl rand -base64 24)" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Note: Grafana only reads GF_SECURITY_ADMIN_PASSWORD when its database is
# created for the first time. For an existing installation change the password
# in the UI or with:  kubectl -n monitoring exec deploy/grafana -- grafana cli admin reset-admin-password '<pw>'
#
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secrets
  namespace: monitoring
type: Opaque
stringData:
  admin-password: "REPLACE_WITH_GENERATED_PASSWORD"
